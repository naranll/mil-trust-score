{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naranll/mil-trust-score/registry/schema.json",
  "title": "Tool registry",
  "description": "One entry per verification tool. Shared by the extension side panel and the website hub. validate.js enforces the same rules without dependencies.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "description", "categories", "audiences", "input", "cost", "needsLogin", "limits", "open", "status", "lastVerified", "sourceUrl"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "name": { "type": "string", "description": "Task-first, e.g. 'Where else has this photo appeared?'" },
      "subtitle": { "type": "string" },
      "description": { "type": "string" },
      "categories": { "type": "array", "minItems": 1, "items": { "enum": ["images", "video", "claims", "sources", "archives", "ai-signals", "geolocation", "documents", "habits"] } },
      "audiences": { "type": "array", "minItems": 1, "items": { "enum": ["journalist", "editor", "researcher", "office"] } },
      "input": { "enum": ["url", "image_url", "text", "claim", "domain", "none"] },
      "cost": { "enum": ["free", "free-with-signup", "paid", "unknown"] },
      "needsLogin": { "type": "boolean" },
      "limits": { "type": "string", "minLength": 20, "description": "Plain-language 'what this can't tell you'. Required." },
      "open": {
        "oneOf": [
          { "type": "object", "required": ["mode", "template", "fallbackUrl"], "additionalProperties": false,
            "properties": { "mode": { "const": "deeplink" }, "template": { "type": "string" }, "fallbackUrl": { "type": "string" } } },
          { "type": "object", "required": ["mode", "adapter"], "additionalProperties": false,
            "properties": { "mode": { "const": "api" }, "adapter": { "enum": ["wayback", "factcheck", "checker", "c2pa", "rdap"] } } },
          { "type": "object", "required": ["mode", "route"], "additionalProperties": false,
            "properties": { "mode": { "const": "internal" }, "route": { "type": "string" } } }
        ]
      },
      "status": { "enum": ["ok", "unverified", "broken"], "description": "Written by linkcheck.mjs. ok = the page loaded with a sample input; whether the input is prefilled is checked by hand." },
      "lastVerified": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
      "sourceUrl": { "type": "string" },
      "mn": {
        "type": "object", "required": ["name", "description", "limits"], "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "limits": { "type": "string" } }
      }
    }
  }
}
