{
  "manifest_version": 3,
  "name": "Итгэлцлийн оноо",
  "version": "0.1.0",
  "description": "Facebook постын манипуляцийн дохиог илрүүлж 0–100 итгэлцлийн оноо, 3 шалтгаан харуулна (HACKMIL 2026).",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "http://127.0.0.1:8000/demo*",
        "http://localhost:8000/demo*",
        "http://127.0.0.1:5500/*",
        "http://localhost:5500/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Итгэлцлийн оноо" }
}
