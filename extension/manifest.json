{
  "manifest_version": 3,
  "name": "Эх сурвалжаа шалга · Check the Source",
  "version": "0.3.0",
  "description": "Шалгах дохио, дүгнэлт биш: Facebook пост, вэб хуудсыг өөрөө шалгах хэрэгсэл, эх сурвалж (HACKMIL 2026).",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "http://127.0.0.1:8000/demo*",
        "http://localhost:8000/demo*",
        "http://127.0.0.1:5500/*",
        "http://localhost:5500/*"
      ],
      "js": ["i18n.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Эх сурвалжаа шалга · Check the Source" }
}
