{
  "manifest_version": 3,
  "name": "Итгэлцлийн оноо",
  "version": "0.2.0",
  "description": "Facebook постын манипуляцийн дохиог илрүүлж, хажуугийн самбарт алхам алхмаар шалгахад туслана (HACKMIL 2026).",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "http://127.0.0.1:8000/demo*",
        "http://localhost:8000/demo*",
        "http://127.0.0.1:5500/*",
        "http://localhost:5500/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Итгэлцлийн оноо — шалгах самбар" }
}
